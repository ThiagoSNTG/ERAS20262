digraph UML {
  graph [bgcolor="white", pad="0.4"];
  node [shape=plain, fontname="Arial"];
  Sistema [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#6d1d20">
    <TR><TD BGCOLOR="#6d1d20"><FONT COLOR="white"><B>SistemaVotacao</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">- opcoes: list[str]<BR ALIGN="LEFT"/>- votos: list[int]</TD></TR>
    <HR/><TR><TD ALIGN="LEFT">+ __init__()<BR ALIGN="LEFT"/>+ registrar_voto(escolha)<BR ALIGN="LEFT"/>+ obter_resultados()</TD></TR>
    </TABLE>>];
}
