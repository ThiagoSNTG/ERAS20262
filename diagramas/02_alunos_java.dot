digraph UML {
  graph [bgcolor="white", pad="0.4"];
  node [shape=plain, fontname="Arial"];
  Sistema [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#6d1d20">
    <TR><TD BGCOLOR="#6d1d20"><FONT COLOR="white"><B>SistemaAlunos</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT">- notas: dict[str, float]<BR ALIGN="LEFT"/>- lista_nomes: list[str]</TD></TR>
    <HR/><TR><TD ALIGN="LEFT">+ __init__()<BR ALIGN="LEFT"/>+ adicionar_aluno(nome, nota)<BR ALIGN="LEFT"/>+ listar_alunos()<BR ALIGN="LEFT"/>+ buscar_nota(nome)</TD></TR>
    </TABLE>>];
}
